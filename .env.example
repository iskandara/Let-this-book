# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These values are not secrets; access is controlled by firestore.rules.
# Leave them empty to run in demo mode, where posts are kept only in this browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
